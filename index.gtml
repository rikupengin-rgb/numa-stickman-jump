<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  
  <!-- PWA・全画面表示用の設定 -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="沼！棒人間">
  <meta name="mobile-web-app-capable" content="yes">

  <!-- ホーム画面アイコン -->
  <link rel="apple-touch-icon" href="https://api.iconify.design/emojione-v1:biohazard-symbol.svg">

  <title>沼！棒人間ジャンプ</title>
  <style>
    * { touch-action: manipulation; -webkit-user-select: none; user-select: none; box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background: #0a0e08;
      color: #fff;
      font-family: sans-serif;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    canvas {
      background: #050a05;
      display: block;
      width: 100%;
      height: 100%;
      max-width: 100vw;
      max-height: 100vh;
      object-fit: contain;
    }
  </style>
</head>
<body>
  <canvas id="game"></canvas>
  <script>
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    
    const W = 400;
    const H = 700;
    canvas.width = W;
    canvas.height = H;

    let state = 'TITLE';
    let player, cameraY, score, highScore = 0;
    let platforms = [], obstacles = [], particles = [], popups = [], jumpEffects = [];
    let shakeTime = 0;

    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playSound(type) {
      try {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        const now = audioCtx.currentTime;
        if (type === 'jump') {
          osc.frequency.setValueAtTime(350, now);
          osc.frequency.exponentialRampToValueAtTime(700, now + 0.08);
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.08);
          osc.start(now); osc.stop(now + 0.08);
        } else if (type === 'swamp') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(120, now);
          osc.frequency.linearRampToValueAtTime(60, now + 0.15);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
          osc.start(now); osc.stop(now + 0.15);
        } else if (type === 'bomb') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(160, now);
          osc.frequency.linearRampToValueAtTime(20, now + 0.25);
          gain.gain.setValueAtTime(0.3, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
          osc.start(now); osc.stop(now + 0.25);
        }
      } catch(e) {}
    }

    function init() {
      player = { x: W / 2, y: H - 100, vx: 0, vy: 0, jumpsLeft: 2, dead: false, parts: [], sinkDepth: 0 };
      cameraY = 0; score = 0;
      platforms = []; obstacles = []; particles = []; popups = []; jumpEffects = []; shakeTime = 0;

      platforms.push({ x: W / 2 - 60, y: H - 60, w: 120, h: 16, type: 'NORMAL', text: 'START', vx: 0, sink: 0 });

      let curY = H - 130;
      for (let i = 0; i < 14; i++) {
        addPlatform(curY);
        curY -= 65 + Math.random() * 20;
      }
    }

    function addPlatform(y) {
      let rand = Math.random();
      let type = 'NORMAL';
      
      if (rand < 0.35) type = 'NORMAL';
      else if (rand < 0.60) type = 'SWAMP'; // 沼足場（乗ると沈む）
      else if (rand < 0.75) type = 'MOVING';
      else if (rand < 0.88) type = 'DISAPPEAR';
      else type = 'BOMB';

      const w = 85 + Math.random() * 35;
      const x = Math.random() * (W - w);
      const vx = (type === 'MOVING') ? (Math.random() > 0.5 ? 1.8 : -1.8) : 0;
      
      let text = 'SAFE!';
      if (type === 'SWAMP') text = '⚠️ 沼';
      else if (type === 'BOMB') text = '❓';
      else if (type === 'DISAPPEAR') text = '❓';

      platforms.push({ x, y, w, h: 16, type, text, vx, sink: 0 });
    }

    function killPlayer(reason = '爆破！') {
      if (player.dead) return;
      player.dead = true;
      state = 'GAMEOVER';
      playSound('bomb');
      shakeTime = 16;

      for (let i = 0; i < 25; i++) {
        particles.push({
          x: player.x, y: player.y,
          vx: (Math.random() - 0.5) * 10,
          vy: (Math.random() - 0.5) * 10,
          size: Math.random() * 6 + 3,
          color: reason.includes('沼') ? '#4a5d23' : '#ff3333',
          life: 25
        });
      }
      popups.push({ x: player.x, y: player.y - 20, text: `💥 ${reason}`, life: 40, vy: -2, color: '#ff4444' });

      player.parts = [
        { x: player.x, y: player.y - 18, vx: (Math.random()-0.5)*8, vy: -7, type: 'head' },
        { x: player.x, y: player.y - 5, vx: (Math.random()-0.5)*8, vy: -5, type: 'line' },
        { x: player.x, y: player.y + 10, vx: (Math.random()-0.5)*8, vy: -4, type: 'line' }
      ];
    }

    function update() {
      if (shakeTime > 0) shakeTime--;

      if (state === 'PLAY') {
        player.vy += 0.32;
        player.vx *= 0.93;
        player.y += player.vy;
        player.x += player.vx;

        if (player.x < 15) { player.x = 15; player.vx *= -0.5; }
        if (player.x > W - 15) { player.x = W - 15; player.vx *= -0.5; }

        if (player.y < cameraY + H * 0.45) {
          let diff = (cameraY + H * 0.45) - player.y;
          cameraY -= diff;
          score = Math.floor(-cameraY);
          if (score > highScore) highScore = score;
        }

        let minY = Math.min(...platforms.map(p => p.y));
        while (minY > cameraY - 100) {
          minY -= 65 + Math.random() * 20;
          addPlatform(minY);
        }
        platforms = platforms.filter(p => p.y < cameraY + H + 100);

        platforms.forEach(p => {
          if (p.type === 'MOVING') {
            p.x += p.vx;
            if (p.x < 10 || p.x + p.w > W - 10) p.vx *= -1;
          }
        });

        // 着地・沼判定
        let onPlatform = false;
        if (player.vy >= 0) {
          platforms.forEach(p => {
            if (
              player.x + 10 > p.x &&
              player.x - 10 < p.x + p.w &&
              player.y + 18 >= p.y + p.sink &&
              player.y + 18 <= p.y + p.h + p.sink + player.vy + 2
            ) {
              if (p.type === 'BOMB') {
                killPlayer('爆弾を踏んだ！');
              } else if (p.type === 'DISAPPEAR') {
                p.y = 99999;
                popups.push({ x: player.x, y: player.y, text: '底が抜けた！', life: 25, vy: -1, color: '#aaa' });
              } else if (p.type === 'SWAMP') {
                // 沼足場：急速に沈む
                onPlatform = true;
                p.sink += 0.8;
                player.y = p.y + p.sink - 18;
                player.vy = 0;
                player.jumpsLeft = 2;

                if (Math.random() < 0.15) playSound('swamp');

                if (p.sink > 22) {
                  killPlayer('沼に呑まれた！');
                }
              } else {
                onPlatform = true;
                player.y = p.y - 18;
                player.vy = 0;
                player.vx = 0;
                player.jumpsLeft = 2;
                if (p.type === 'MOVING') player.x += p.vx;
              }
            }
          });
        }

        if (player.y > cameraY + H + 50) killPlayer('落下した！');
      }

      if (player && player.parts) {
        player.parts.forEach(pt => { pt.vy += 0.4; pt.x += pt.vx; pt.y += pt.vy; });
      }

      particles.forEach(p => { p.x += p.vx; p.y += p.vy; p.life--; });
      particles = particles.filter(p => p.life > 0);

      jumpEffects.forEach(e => { e.r += 1.5; e.alpha -= 0.08; });
      jumpEffects = jumpEffects.filter(e => e.alpha > 0);

      popups.forEach(p => { p.y += p.vy; p.life--; });
      popups = popups.filter(p => p.life > 0);
    }

    function drawStickman(x, y, vy, dead) {
      if (dead) return;
      ctx.strokeStyle = '#66ff66';
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.arc(x, y - 16, 6, 0, Math.PI * 2);
      ctx.moveTo(x, y - 10); ctx.lineTo(x, y + 4);
      let armY = vy < 0 ? y - 14 : y - 4;
      ctx.moveTo(x - 9, armY); ctx.lineTo(x, y - 6); ctx.lineTo(x + 9, armY);
      let legX = vy < 0 ? 7 : 4;
      ctx.moveTo(x - legX, y + 16); ctx.lineTo(x, y + 4); ctx.lineTo(x + legX, y + 16);
      ctx.stroke();
    }

    function draw() {
      ctx.save();
      if (shakeTime > 0) ctx.translate((Math.random() - 0.5) * 8, (Math.random() - 0.5) * 8);

      ctx.fillStyle = '#071007';
      ctx.fillRect(0, 0, W, H);

      ctx.save();
      ctx.translate(0, -cameraY);

      platforms.forEach(p => {
        let color = '#2a3a2a', border = '#4a6a4a', txt = p.text;
        
        if (p.type === 'SWAMP') {
          color = '#3b2d13';
          border = '#8c6b2d';
          txt = '⚠️ 沼 (ズブズブ)';
        } else if (p.type === 'BOMB') {
          color = '#4a1a1a';
          border = '#aa3333';
        }

        ctx.fillStyle = color; 
        ctx.fillRect(p.x, p.y + p.sink, p.w, p.h);
        ctx.strokeStyle = border; 
        ctx.lineWidth = 1.5; 
        ctx.strokeRect(p.x, p.y + p.sink, p.w, p.h);

        ctx.fillStyle = '#aaffaa'; ctx.font = 'bold 11px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(txt, p.x + p.w / 2, p.y + p.sink + 12);
      });

      jumpEffects.forEach(e => {
        ctx.strokeStyle = `rgba(100, 255, 100, ${e.alpha})`;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);
        ctx.stroke();
      });

      if (player) {
        drawStickman(player.x, player.y, player.vy, player.dead);
        if (player.dead && player.parts) {
          ctx.strokeStyle = '#ff3333'; ctx.lineWidth = 2;
          player.parts.forEach(pt => {
            ctx.beginPath();
            if (pt.type === 'head') ctx.arc(pt.x, pt.y, 5, 0, Math.PI * 2);
            else { ctx.moveTo(pt.x - 4, pt.y - 4); ctx.lineTo(pt.x + 4, pt.y + 4); }
            ctx.stroke();
          });
        }
      }

      particles.forEach(p => { ctx.fillStyle = p.color; ctx.fillRect(p.x, p.y, p.size, p.size); });
      popups.forEach(p => { ctx.fillStyle = p.color; ctx.font = 'bold 16px sans-serif'; ctx.textAlign = 'center'; ctx.fillText(p.text, p.x, p.y); });

      ctx.restore();

      ctx.fillStyle = '#33ff33'; ctx.font = 'bold 16px monospace'; ctx.textAlign = 'left';
      ctx.fillText(`DEPTH: ${score}m`, 15, 30);
      ctx.fillStyle = '#ffcc00'; ctx.fillText(`RECORD: ${highScore}m`, 15, 50);

      if (state === 'TITLE') {
        ctx.fillStyle = 'rgba(0,15,0,0.85)'; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#33ff66'; ctx.font = 'bold 24px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText('☣️ 沼！棒人間ジャンプ', W / 2, H / 2 - 50);
        ctx.fillStyle = '#aaa'; ctx.font = '13px sans-serif';
        ctx.fillText('👈 左タップ：左へジャンプ', W / 2, H / 2 - 10);
        ctx.fillText('👉 右タップ：右へジャンプ', W / 2, H / 2 + 10);
        ctx.fillStyle = '#ff9933';
        ctx.fillText('⚠️ 茶色の「沼足場」は乗ると沈むぞ！', W / 2, H / 2 + 40);
        ctx.fillStyle = '#33ff66'; ctx.font = 'bold 16px sans-serif';
        ctx.fillText('👉 タップしてスタート 👈', W / 2, H / 2 + 90);
      }

      if (state === 'GAMEOVER') {
        ctx.fillStyle = 'rgba(15,0,0,0.8)'; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#ff3333'; ctx.font = 'bold 28px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText('💀 沼没・死亡！', W / 2, H / 2 - 40);
        ctx.fillStyle = '#fff'; ctx.font = '16px sans-serif';
        ctx.fillText(`到達深さ: ${score}m`, W / 2, H / 2 + 5);
        ctx.fillStyle = '#aaa'; ctx.font = '13px sans-serif';
        ctx.fillText('タップしてリトライ', W / 2, H / 2 + 45);
      }
      ctx.restore();
    }

    function loop() { update(); draw(); requestAnimationFrame(loop); }

    function handleInput(e) {
      if (e) e.preventDefault();
      
      const rect = canvas.getBoundingClientRect();
      let clientX = rect.width / 2;
      
      if (e.touches && e.touches.length > 0) {
        clientX = e.touches[0].clientX - rect.left;
      } else if (e.clientX !== undefined) {
        clientX = e.clientX - rect.left;
      }

      const isLeft = clientX < (rect.width / 2);

      if (state === 'TITLE' || state === 'GAMEOVER') { 
        state = 'PLAY'; init(); 
      } else if (state === 'PLAY') {
        if (player.jumpsLeft > 0) {
          player.vy = -8.8;
          player.vx = isLeft ? -4.2 : 4.2;

          if (player.jumpsLeft === 1) {
            jumpEffects.push({ x: player.x, y: player.y + 15, r: 5, alpha: 1.0 });
          }

          player.jumpsLeft--;
          playSound('jump');
        }
      }
    }

    window.addEventListener('touchstart', handleInput, { passive: false });
    window.addEventListener('mousedown', handleInput);
    init(); state = 'TITLE'; loop();
  </script>
</body>
</html>
